# Copy locally to .env.local. Never commit real values.
# Set production in the live hosting environment, preview for integration tests.
TRIPCOOKER_RELEASE_TARGET=preview
NEXT_PUBLIC_APP_MODE=live
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical production origin. Use the actual preview origin in staging.
APP_URL=https://tripcooker.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# Dedicated TripCooker portal, never the company's shared default configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
# Keep false until account, checkout, cancellation and policy checks pass.
PAYMENTS_ENABLED=false
# Explicit initial Free release while payouts are under review. Never enables purchases.
TRIPCOOKER_FREE_LAUNCH=false
# Public address only; set after forwarding and delivery have been verified.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set to the version in src/lib/policy-release.json only after owner review.
NEXT_PUBLIC_APPROVED_POLICY_VERSION=
